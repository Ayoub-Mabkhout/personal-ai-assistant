# Template only. These variables are NOT automatically loaded from this file.
# Calendar code reads ASSISTANT_STATE_DIR from its process environment.
# Keep real values in config/local/ or an external protected secret store.
# ASSISTANT_STATE_DIR=C:/path/outside/OneDrive/assistant-state
# Future relay configuration (not implemented):
# ASSISTANT_RELAY_URL=https://assistant.example.com
# Credentials are resolved from the OS credential store, never from this template.
