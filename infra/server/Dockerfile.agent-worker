ARG NODE_IMAGE=node@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d
ARG RELAY_IMAGE=personal-assistant-relay:latest

FROM ${NODE_IMAGE} AS cli
RUN npm install --prefix /cli --omit=dev --no-audit --no-fund \
    @openai/codex@0.166.0 @anthropic-ai/claude-code@2.1.318

FROM ${RELAY_IMAGE}
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ripgrep tini \
    && rm -rf /var/lib/apt/lists/*
COPY --from=cli /usr/local/bin/node /usr/local/bin/node
COPY --from=cli /cli /opt/agent-cli
ENV PATH="/opt/agent-cli/node_modules/.bin:/usr/local/bin:/usr/bin:/bin"
WORKDIR /home/assistant
USER 10001:10001
ENTRYPOINT ["/usr/bin/tini", "--"]
