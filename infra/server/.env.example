# Public configuration template only; real files are generated outside Git.
ASSISTANT_DOMAIN=assistant.example.com
ACME_EMAIL=owner@example.com
ASSISTANT_TIMEZONE=Europe/Berlin
ASSISTANT_DATA_DIR=/opt/personal-assistant/data
ASSISTANT_SECRET_DIR=/opt/personal-assistant/secrets
ASSISTANT_CADDY_CONFIG=Caddyfile.bootstrap
ASSISTANT_WHISPER_MODEL=base-int8
