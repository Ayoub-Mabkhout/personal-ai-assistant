<queries><intent><action android:name="android.intent.action.SET_ALARM"/></intent></queries>
<application android:label="Assistant Companion" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@style/AssistantTheme" android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
