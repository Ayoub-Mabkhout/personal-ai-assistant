<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <gradient android:angle="315" android:startColor="@color/widget_bg_start" android:endColor="@color/widget_bg_end"/>
            <stroke android:width="1dp" android:color="@color/widget_stroke"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <gradient android:type="radial" android:centerX="0.15" android:centerY="0" android:gradientRadius="240dp" android:startColor="@color/widget_glow" android:endColor="#00000000"/>
        </shape>
    </item>
</layer-list>
