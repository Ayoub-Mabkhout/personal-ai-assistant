<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#38FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <gradient android:angle="0" android:startColor="@color/widget_primary_start" android:endColor="@color/widget_primary_end"/>
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <solid android:color="#FFFFFFFF"/>
        </shape>
    </item>
</ripple>
