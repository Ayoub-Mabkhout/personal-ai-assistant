<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/money_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MONEY · SAFE PER DAY" android:textColor="@color/widget_muted" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/money_daily" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="—" android:textColor="@color/widget_text" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:id="@+id/money_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="per day" android:textColor="@color/widget_muted" android:textSize="12sp" />
    <ImageView android:id="@+id/money_strip" android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginTop="12dp" android:contentDescription="Category spending proportions" android:scaleType="fitXY" />
    <TextView android:id="@+id/money_categories" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:text="Categories appear after sync" android:textColor="@color/widget_muted" android:textSize="10sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="LEADING CATEGORY" android:textColor="@color/widget_muted" android:textSize="10sp" android:textStyle="bold" />
    <TextView android:id="@+id/money_leading" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="Waiting for data" android:textColor="@color/widget_text" android:textSize="16sp" android:textStyle="bold" />
</LinearLayout>
