<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.personalassistant.wakeprobe">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.CAPTURE_AUDIO_HOTWORD"/>
  <uses-permission android:name="android.permission.MANAGE_HOTWORD_DETECTION"/>
  <uses-permission android:name="android.permission.MANAGE_VOICE_KEYPHRASES"/>
  <uses-permission android:name="android.permission.MANAGE_SOUND_TRIGGER"/>
  <queries><intent><action android:name="com.android.intent.action.MANAGE_VOICE_KEYPHRASES"/></intent></queries>
  <application android:label="Assistant hardware probe" android:allowBackup="false" android:debuggable="true">
    <activity android:name=".ProbeActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
    <service android:name=".ProbeService" android:permission="android.permission.BIND_VOICE_INTERACTION" android:exported="true"><intent-filter><action android:name="android.service.voice.VoiceInteractionService"/></intent-filter><meta-data android:name="android.voice_interaction" android:resource="@xml/probe_voice"/></service>
    <service android:name=".ProbeSessions" android:permission="android.permission.BIND_VOICE_INTERACTION" android:exported="true"/>
  </application>
</manifest>
